[application]

config/name="FFBE Remastered"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ContentRepository="*res://core/content_repository.gd"
SaveManager="*res://core/save_manager.gd"
LocaleManager="*res://core/locale_manager.gd"
PlayerState="*res://core/player_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

