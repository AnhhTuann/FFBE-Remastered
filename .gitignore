# Temporary source inspection and local caches
.audit-cache/
.cache/
*.tmp
*.log

# Python audit tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Generated source downloads and restricted third-party assets
# Raw game data must never be committed to this public repository.
data/raw/global/*
data/raw/japan/*
!data/raw/global/.gitkeep
!data/raw/japan/.gitkeep
*.cpk
*.apk
*.zip
*.dat
*.bmb
*.m3r
*.ssbp

# Godot engine cache, imports, editor state and local runtime data
.godot/
game/.godot/
game/imported/
game/user/
game/logs/

# Godot build outputs and export templates
builds/
game/build/
game/exports/
export/
*.tpz

# Restricted source material and local credentials
data/raw/*
!data/raw/global/
!data/raw/japan/
data/restricted/
game/data/restricted/
*.env
*.pem
*.key
*.keystore
